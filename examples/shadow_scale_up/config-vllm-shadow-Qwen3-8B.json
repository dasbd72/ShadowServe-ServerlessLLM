{
    "model": "Qwen/Qwen3-8B",
    "backend": "vllm",
    "num_gpus": 1,
    "auto_scaling_config": {
        "metric": "concurrency",
        "target": 2,
        "min_instances": 1,
        "max_instances": 2
    },
    "router_config": {
        "shadow_scale_up": true,
        "shadow_num_cpus": 12,
        "kvhts_ipc_prefix": "/tmp/vllm-shadow-kvhts",
        "kvstc_ipc_prefix": "/tmp/vllm-shadow-kvstc"
    },
    "backend_config": {
        "pretrained_model_name_or_path": "Qwen/Qwen3-8B",
        "torch_dtype": "bfloat16",
        "enforce_eager": false,
        "enable_prefix_caching": true,
        "shadow_sender_enabled": true,
        "shadow_additional_blocks_per_request": 20,
        "shadow_tksth_ipc_prefix": "/tmp/vllm-shadow-tksth",
        "shadow_receiver_enabled": true,
        "block_size": 16
    }
}